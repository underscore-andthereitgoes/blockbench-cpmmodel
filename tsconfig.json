{
  "include": ["bbcpmm.ts"],
  "compileOnSave": true,
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "types": ["blockbench-types"],
    "allowUmdGlobalAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [],
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules"
  ]
}